{
  "name": "ts3-screenshare-signaling",
  "version": "0.1.0",
  "description": "WebSocket relay for TS3 screen share: rooms keyed by TS3 channel id",
  "type": "module",
  "main": "./dist/index.js",
  "author": "Konrad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "keys": "tsx src/cli-keys.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  },
  "engines": {
    "node": ">=18"
  }
}
