# Modul natywny jest zalezoscia typu file:. Domyslnie npm robi na niego
# symlink poza katalog projektu, a electron-builder odmawia pakowania czegos,
# co lezy wyzej niz companion-app ("must be under ..."). install-links wymusza
# prawdziwa kopie w node_modules i paczka daje sie zbudowac.
#
# Skutek uboczny: kopia nie odswieza sie sama po przebudowaniu modulu, a
# `npm install --force` tego NIE naprawia (sprawdzone). Jedyny pewny sposob to
# usunac katalog i zainstalowac ponownie — robi to `npm run sync:native`,
# wpiete w `package` i `installer`, zeby nie dalo sie spakowac starej wersji.
install-links=true
