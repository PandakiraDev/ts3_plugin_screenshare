{
  "name": "ts3-screenshare-companion",
  "version": "0.1.0",
  "description": "Companion app for TS3 screen sharing: source picker + capture",
  "main": "./out/main/index.js",
  "author": "Konrad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/lobby.mjs",
    "lobby": "electron . --user-data-dir=.tmp/profil-1 --ts3-server=ts.test.pl:9987 --channel=42 --signaling=ws://127.0.0.1:8080",
    "e2e:fps": "node e2e/fps-stats.mjs",
    "e2e:kamera": "node e2e/kamera.mjs",
    "e2e:audio": "npm run sync:native && npm run build && node e2e/app-audio.mjs",
    "lobby:2": "electron . --user-data-dir=.tmp/profil-2 --ts3-server=ts.test.pl:9987 --channel=42 --signaling=ws://127.0.0.1:8080",
    "sync:native": "node -e \"require('node:fs').rmSync('node_modules/ts3-screenshare-audio',{recursive:true,force:true})\" && npm install --no-audit --no-fund",
    "package": "npm run sync:native && npm run build && electron-builder --win --dir",
    "installer": "npm run sync:native && npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "ws": "^8.21.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts3-screenshare-audio": "file:../audio-native"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "ts3-screenshare-audio@0.1.0": true
  }
}
