{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron.vite.config.ts",
    // Bez tego wpisu katalog test/ w ogóle nie jest sprawdzany typami — testy
    // pilnujące WŁAŚCIWOŚCI TYPÓW (np. że funkcja jest generyczna) przechodziłyby
    // na zielono nawet wtedy, gdy ta właściwość jest złamana, bo tsc nigdy by ich
    // nie zobaczył. Znalezione na pustym teście.
    "test/**/*.ts"
  ]
}
